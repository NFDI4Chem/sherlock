VERSION="v1.2.1"

# server settings
SHERLOCK_URL="http://localhost:8080"
CONTEXT_PATH="/"

## security
# java spring security
SPRING_SECURITY_USER_NAME="admin"
SPRING_SECURITY_USER_PASSWORD="password"
SHERLOCK_CORS_ALLOWED_ORIGIN_PATTERNS="http://localhost:*,http://127.0.0.1:*"
# databases
MONGO_INITDB_ROOT_USERNAME="admin"
MONGO_INITDB_ROOT_PASSWORD="password"
POSTGRES_USER="admin"
POSTGRES_PASSWORD="password"
# result password check (true or false)
SHERLOCK_RESULT_PASSWORD_CHECK_ENABLED=true

## volume mounts
# # NMRShiftDB dataset path
# DATASET_NMRSHIFTDB_PATH="./data/nmrshiftdb"
# # directory path for databases containing spectral predictions via ACD/Labs
# DATASET_ACD_LABS_PREDICTIONS_PATH="./data/acd_labs_predictions"

# # custom filters
# CUSTOM_FILTERS_PATH="./data/lsd/filters"